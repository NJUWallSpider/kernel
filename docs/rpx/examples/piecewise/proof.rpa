RPA 12
.forward
  split x0
  left a0
    ret (-x0) (
      a0,      ; y lower
      v0.lo,   ; y upper
      exact,   ; objective nonincreasing
    )
  right a0
    ret (x0) (
      a0,      ; y lower
      v0.hi,   ; y upper
      exact,   ; objective nonincreasing
    )
  end

.reverse
  lin.le f0, v0.lo - 1
  ret (x0) (
    f0,      ; x lower
    v0.hi,   ; x upper
    exact,   ; objective nonincreasing
  )
