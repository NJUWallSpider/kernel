RPA 12
.forward
  ret (x0) (
    v0.lo,   ; variable y lower
    v0.hi,   ; variable y upper
    r0.hi,   ; row cap upper
    exact,   ; objective nonincreasing
  )

.reverse
  lin.le f0, r0.hi - 1
  ret (x0) (
    v0.lo,   ; variable x lower
    v0.hi,   ; variable x upper
    r0.hi,   ; row cap upper
    f0,      ; row loose upper
    exact,   ; objective nonincreasing
  )
