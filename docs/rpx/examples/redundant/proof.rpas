RPA-S 1
models { source: "source.lp", target: "target.lp" }
certificate {
  forward: {
    steps: [],
    end: Return {
      map: [expr(x0)],
      checks {
        variable["y"].lower: lower(x0),
        variable["y"].upper: upper(x0),
        row["cap"].upper: row_upper(0),
        objective.non_increasing: exact,
      },
    },
  },
  reverse: {
    steps: [lin.le(f0, row_upper(0) - 1)],
    end: Return {
      map: [expr(x0)],
      checks {
        variable["x"].lower: lower(x0),
        variable["x"].upper: upper(x0),
        row["cap"].upper: row_upper(0),
        row["loose"].upper: f0,
        objective.non_increasing: exact,
      },
    },
  },
}
