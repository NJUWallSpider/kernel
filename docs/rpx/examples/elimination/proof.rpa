RPA 12
.forward
  lin.eq f0, -r0.eq
  ret (x1) (
    v1.lo,   ; y lower
    v1.hi,   ; y upper
    f0,      ; objective nonincreasing
  )

.reverse
  ret (1 - x0, x0) (
    v0.hi,   ; x0 lower
    v0.lo,   ; x0 upper
    v0.lo,   ; x1 lower
    v0.hi,   ; x1 upper
    exact,   ; balance equal
    exact,   ; objective nonincreasing
  )
