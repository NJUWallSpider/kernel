RPA-S 1
models { source: "source.lp", target: "target.lp" }
certificate {
  forward: {
    steps: [lin.eq(f0, -row_eq(0))],
    end: Return {
      map: [expr(x1)],
      checks {
        variable["y"].lower: lower(x1),
        variable["y"].upper: upper(x1),
        objective.non_increasing: f0,
      },
    },
  },
  reverse: {
    steps: [],
    end: Return {
      map: [expr(1 - x0), expr(x0)],
      checks {
        variable["x0"].lower: upper(x0),
        variable["x0"].upper: lower(x0),
        variable["x1"].lower: lower(x0),
        variable["x1"].upper: upper(x0),
        row["balance"].equal: exact,
        objective.non_increasing: exact,
      },
    },
  },
}
