from ._native import Model, Scope, Path, CertificateView
from .artifacts import Bundle, VerificationReport
from typing import Any

class Proof:
    def __init__(self, source: Model | Path, target: Model | Path) -> None: ...
    @property
    def source(self) -> Model: ...
    @property
    def target(self) -> Model: ...
    @property
    def forward(self) -> Scope: ...
    @property
    def reverse(self) -> Scope: ...
    def preflight(self) -> dict[str, int]: ...
    def certificate(self) -> CertificateView: ...
    def compile(
        self, directory: Path, *, target_artifact: Path | None = None
    ) -> Bundle: ...
    def verify(
        self,
        directory: Path,
        *,
        target_artifact: Path | None = None,
        work: int | None = None,
        live_facts: int | None = None,
        depth: int | None = None
    ) -> VerificationReport: ...

class StandardMPSAdapter:
    def __init__(
        self,
        source: Model,
        *,
        objective_auxiliary: bool = True,
        objective_name: str = "__mps_objective"
    ) -> None: ...
    @property
    def source(self) -> Model: ...
    @property
    def target(self) -> Model: ...
    @property
    def report(self) -> dict[str, Any]: ...
    def proof(self) -> Proof: ...
