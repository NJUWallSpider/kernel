from __future__ import annotations
import builtins
from collections.abc import Iterable, Iterator, Mapping, Sequence
from decimal import Decimal
from fractions import Fraction
from os import PathLike
from typing import Any, Literal, overload

Scalar = int | str | Q | Fraction | Decimal
Affine = Expr | Scalar
Variable = str | int | VarRef
Kind = Literal["Eq", "Le", "Int"]
Path = str | PathLike[str]

class CompilerError(ValueError): ...
class CoordinateSpaceError(CompilerError): ...
class ScopeError(CompilerError): ...
class MappingError(CompilerError): ...
class InvalidDerivationError(CompilerError): ...
class UnprovedGoalError(CompilerError): ...
class ResourceLimitError(CompilerError): ...
class ArtifactMismatchError(CompilerError): ...
class KernelRejectedError(CompilerError): ...

class Q:
    def __init__(self, numerator: Scalar = 0, denominator: Scalar = 1) -> None: ...
    @property
    def numerator(self) -> int: ...
    @property
    def denominator(self) -> int: ...
    def __add__(self, other: Scalar) -> Q: ...
    def __radd__(self, other: Scalar) -> Q: ...
    def __sub__(self, other: Scalar) -> Q: ...
    def __rsub__(self, other: Scalar) -> Q: ...
    def __mul__(self, other: Scalar) -> Q: ...
    def __rmul__(self, other: Scalar) -> Q: ...
    def __truediv__(self, other: Scalar) -> Q: ...
    def __rtruediv__(self, other: Scalar) -> Q: ...
    def __neg__(self) -> Q: ...
    def __abs__(self) -> Q: ...
    def __int__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __lt__(self, other: Scalar) -> bool: ...
    def __le__(self, other: Scalar) -> bool: ...
    def __gt__(self, other: Scalar) -> bool: ...
    def __ge__(self, other: Scalar) -> bool: ...

class Expr:
    def __init__(self, constant: Scalar = 0) -> None: ...
    @property
    def constant(self) -> Q: ...
    @property
    def terms(self) -> TermsView: ...
    def __add__(self, other: Affine) -> Expr: ...
    def __radd__(self, other: Affine) -> Expr: ...
    def __sub__(self, other: Affine) -> Expr: ...
    def __rsub__(self, other: Affine) -> Expr: ...
    def __mul__(self, other: Scalar) -> Expr: ...
    def __rmul__(self, other: Scalar) -> Expr: ...
    def __truediv__(self, other: Scalar) -> Expr: ...
    def __neg__(self) -> Expr: ...
    @staticmethod
    def from_terms(
        space: Model,
        indices: Iterable[int],
        coefficients: Iterable[Scalar],
        constant: Scalar = 0,
    ) -> Expr: ...
    @staticmethod
    def dot(coefficients: Iterable[Scalar], variables: Iterable[Affine]) -> Expr: ...
    def substitute(
        self, replacements: Mapping[int, Affine] | Sequence[Affine] | MappingView
    ) -> Expr: ...
    def evaluate(self, values: Mapping[str, Scalar] | Sequence[Scalar]) -> Q: ...
    def to_dict(self) -> dict[str, Any]: ...

class TermsView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Q: ...
    def __iter__(self) -> Iterator[int]: ...
    def keys(self) -> Iterator[int]: ...
    def items(self) -> Iterator[tuple[int, Q]]: ...
    def values(self) -> Iterator[Q]: ...
    def get(self, index: int, default: Any = None) -> Any: ...
    def to_dict(self) -> dict[int, Q]: ...

class VarRef(Expr):
    @property
    def name(self) -> str: ...
    @property
    def index(self) -> int: ...
    @property
    def integer(self) -> bool: ...
    @property
    def lower(self) -> Q | None: ...
    @property
    def upper(self) -> Q | None: ...

class RowRef:
    @property
    def name(self) -> str: ...
    @property
    def index(self) -> int: ...
    @property
    def expression(self) -> Expr: ...
    @property
    def lower(self) -> Q | None: ...
    @property
    def upper(self) -> Q | None: ...
    @property
    def equality(self) -> bool: ...

class VariablesView:
    def __len__(self) -> int: ...
    def __getitem__(self, key: Variable) -> VarRef: ...
    def __contains__(self, name: str) -> bool: ...
    def __iter__(self) -> Iterator[VarRef]: ...
    def iter(self, limit: int | None = None) -> Iterator[VarRef]: ...
    def to_list(self) -> list[VarRef]: ...

class RowsView:
    def __len__(self) -> int: ...
    def __getitem__(self, key: str | int) -> RowRef: ...
    def __contains__(self, name: str) -> bool: ...
    def __iter__(self) -> Iterator[RowRef]: ...
    def iter(self, limit: int | None = None) -> Iterator[RowRef]: ...
    def to_list(self) -> list[RowRef]: ...

class Model:
    @staticmethod
    def read(path: Path) -> Model: ...
    @property
    def name(self) -> str: ...
    @property
    def vars(self) -> VariablesView: ...
    @property
    def rows(self) -> RowsView: ...
    @property
    def objective(self) -> Expr: ...
    def renamed(self, name: str) -> Model: ...
    def with_objective(self, expression: Affine) -> Model: ...
    def with_bounds(
        self,
        variable: Variable,
        *,
        lower: Scalar | None = ...,
        upper: Scalar | None = ...,
    ) -> Model: ...
    def with_integrality(
        self, variables: Variable | Iterable[Variable], integer: bool
    ) -> Model: ...
    def add_variable(
        self,
        name: str,
        *,
        integer: bool = False,
        lower: Scalar | None = None,
        upper: Scalar | None = None,
    ) -> Model: ...
    def add_row(
        self,
        name: str,
        expression: Affine,
        *,
        lower: Scalar | None = None,
        upper: Scalar | None = None,
        equal: Scalar | None = None,
    ) -> Model: ...
    def replace_row(
        self,
        row: str | int,
        *,
        expression: Affine = ...,
        lower: Scalar | None = ...,
        upper: Scalar | None = ...,
    ) -> Model: ...
    def delete_rows(self, rows: str | int | Iterable[str | int]) -> Model: ...
    def substitute(
        self,
        replacements: dict[Variable, Affine],
        *,
        remove: bool = True,
        drop_rows: Iterable[str | int] | None = None,
        preserve_bounds: bool = True,
    ) -> Model: ...
    def is_binary(self, variable: Variable) -> bool: ...
    def support(self, row: str | int) -> list[int]: ...
    def row_activity(self, row: str | int) -> tuple[Q | None, Q | None]: ...
    def check_point(
        self, values: Mapping[str, Scalar] | Sequence[Scalar], *, integers: bool = True
    ) -> list[dict[str, Any]]: ...
    def stats(self) -> dict[str, Any]: ...
    def same_formulation(self, other: Model) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_mps(self, *, rational_literals: bool = False) -> str: ...
    def write_mps(
        self, path: Path, *, rational_literals: bool = False
    ) -> PathLike[str]: ...
    def write_mcm(self, path: Path) -> PathLike[str]: ...

class ModelBuilder:
    def __init__(self, name: str = "MODEL") -> None: ...
    def add_var(
        self,
        name: str,
        *,
        integer: bool = False,
        lower: Scalar | None = None,
        upper: Scalar | None = None,
    ) -> VarRef: ...
    def add_row(
        self,
        name: str,
        expression: Affine,
        *,
        lower: Scalar | None = None,
        upper: Scalar | None = None,
        equal: Scalar | None = None,
    ) -> None: ...
    def minimize(self, expression: Affine) -> None: ...
    def build(self) -> Model: ...

def quicksum(items: Iterable[Affine]) -> Expr: ...

Combination = Fact | LinCombination | Scalar

class LinCombination:
    def __add__(self, other: Combination) -> LinCombination: ...
    def __radd__(self, other: Combination) -> LinCombination: ...
    def __sub__(self, other: Combination) -> LinCombination: ...
    def __rsub__(self, other: Combination) -> LinCombination: ...
    def __mul__(self, other: Scalar) -> LinCombination: ...
    def __rmul__(self, other: Scalar) -> LinCombination: ...
    def __truediv__(self, other: Scalar) -> LinCombination: ...
    def __neg__(self) -> LinCombination: ...

class Fact:
    @property
    def kind(self) -> Kind: ...
    @property
    def expression(self) -> Expr: ...
    def __add__(self, other: Combination) -> LinCombination: ...
    def __radd__(self, other: Combination) -> LinCombination: ...
    def __sub__(self, other: Combination) -> LinCombination: ...
    def __rsub__(self, other: Combination) -> LinCombination: ...
    def __mul__(self, other: Scalar) -> LinCombination: ...
    def __rmul__(self, other: Scalar) -> LinCombination: ...
    def __truediv__(self, other: Scalar) -> LinCombination: ...
    def __neg__(self) -> LinCombination: ...

class Goal:
    @property
    def kind(self) -> Kind: ...
    @property
    def label(self) -> str: ...
    @property
    def expression(self) -> Expr: ...
    @property
    def discharged(self) -> bool: ...

class ObligationView:
    @property
    def count(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: int | str) -> Goal: ...
    def to_list(self) -> list[Goal]: ...
    def summary(self) -> dict[str, int]: ...

class MappingView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Expr: ...

class Scope:
    @property
    def model(self) -> Model: ...
    @property
    def output(self) -> Model: ...
    @property
    def vars(self) -> VariablesView: ...
    @property
    def derive(self) -> Derive: ...
    @property
    def assumption(self) -> Fact: ...
    @property
    def mapping(self) -> MappingView: ...
    @property
    def obligations(self) -> ObligationView: ...
    @property
    def trace(self) -> TraceView: ...
    def map(
        self,
        overrides: dict[str, Affine] | None = None,
        *,
        default: Literal["same_name"] | None = None,
    ) -> Scope: ...
    def pullback(self, expression: Affine) -> Expr: ...
    def plan(self) -> ObligationView: ...
    def missing(
        self, *, limit: int | None = None, kind: str | None = None
    ) -> ObligationView: ...
    def row(
        self, row: str | int, *, side: Literal["lower", "upper", "equal"] | None = None
    ) -> Fact: ...
    def lower(self, variable: Variable) -> Fact: ...
    def upper(self, variable: Variable) -> Fact: ...
    def integer(self, variable: Variable) -> Fact: ...
    def prove(self, goal: str | Goal, *, by: Combination) -> Fact: ...
    def finish(self) -> Scope: ...
    def drop(self, facts: Fact | Iterable[Fact]) -> None: ...
    def close_absurd(self, fact: Fact) -> None: ...
    def conclude(self, fact: Fact) -> None: ...
    def split(
        self,
        expr: Affine,
        *,
        at: Scalar = 0,
        kind: Literal["continuous", "integer"] = "continuous",
        because: Fact | None = None,
    ) -> tuple[Scope, Scope]: ...
    def lift_interval(
        self, *, lower: Affine, upper: Affine, because: Fact | None = None
    ) -> LiftResult: ...
    def lift_intervals(self, specs: Iterable[Any]) -> LiftResult: ...
    def lift_menus(self, specs: Iterable[Any]) -> LiftResult: ...
    def lift_signed(self, specs: Iterable[Any]) -> LiftResult: ...
    def lift_flow(self, spec: Any) -> LiftResult: ...
    def lift_subflow(self, spec: Any) -> LiftResult: ...

class Derive:
    def eq(self, by: Combination, *, expect: Affine | None = None) -> Fact: ...
    def le(self, by: Combination, *, expect: Affine | None = None) -> Fact: ...
    def int(self, by: Combination, *, expect: Affine | None = None) -> Fact: ...
    def round(self, le: Fact, integer: Fact) -> Fact: ...
    def eqpair(self, positive: Fact, negative: Fact) -> Fact: ...
    def box_le(self, expression: Affine) -> Fact: ...
    def eq_on_fixed(
        self, expression: Affine, fixes: dict[Variable, Fact] | None = None
    ) -> Fact: ...
    def rewrite(
        self,
        fact: Fact,
        definitions: dict[Variable, Fact],
        *,
        expect: Affine | None = None,
    ) -> Fact: ...
    def rewrite_many(
        self, facts: Iterable[Fact], definitions: dict[Variable, Fact]
    ) -> list[Fact]: ...
    def substitution(
        self,
        definitions: dict[Variable, Fact],
        *,
        goals: Iterable[Affine] | None = None,
    ) -> list[Fact]: ...
    def substitution_fact(
        self,
        goal: Affine,
        definitions: dict[Variable, Fact],
        residual: Fact,
        *,
        kind: Kind | None = None,
    ) -> Fact: ...
    def zero_sum(
        self,
        fact: Fact,
        *,
        zeros: dict[Variable, Fact] | None = None,
        scale: Scalar = 1,
        coordinates: Iterable[Variable] | None = None,
    ) -> dict[str, Fact]: ...
    def parity_fix(self, variable: Variable, equality: Fact) -> Fact: ...
    def subset_bounds(
        self, fact: Fact, subsets: Iterable[Iterable[Variable]]
    ) -> list[Fact]: ...
    def plotkin(
        self,
        *,
        bits: builtins.int,
        distance: builtins.int,
        variables: Iterable[tuple[Variable, builtins.int]],
        cliques: Iterable[Fact],
    ) -> Fact: ...
    def cases(
        self, split: Affine, *, kind: Kind, expect: Affine, integer: Fact | None = None
    ) -> Cases: ...

class Cases:
    @property
    def left(self) -> Scope: ...
    @property
    def right(self) -> Scope: ...
    def finish(self) -> Fact: ...

class LiftResult:
    @property
    def scope(self) -> Scope: ...
    @property
    def variable(self) -> VarRef: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Generated: ...

class Generated:
    # Fields depend on the selected Kernel extension; invalid fields raise AttributeError.
    variable: VarRef
    lower_rows: Sequence[Fact]
    upper_rows: Sequence[Fact]
    options: Sequence[VarRef]
    sum: Fact
    moment: Fact
    positive: VarRef
    negative: VarRef
    positive_activation: VarRef
    negative_activation: VarRef
    flow: Fact
    activation: Fact
    positive_capacity: Fact
    negative_capacity: Fact
    source: int
    sink: int
    demand: Q
    flows: Sequence[VarRef]
    commodities: Sequence[Generated]
    balances: Sequence[Fact]
    recovery: Sequence[Fact]
    remainder_nonnegative: Sequence[Fact]

class TraceView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> StepView: ...
    def to_list(self) -> list[dict[str, Any]]: ...

class CertificateView:
    def __len__(self) -> int: ...
    def __getitem__(
        self, key: Literal["forward", "reverse"]
    ) -> CertificateBlockView: ...
    def to_dict(self) -> dict[str, Any]: ...

class CertificateBlockView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> StepView: ...
    def to_dict(self) -> dict[str, Any]: ...

class Assembler:
    def __init__(self, scope: Scope) -> None: ...
    def linear(
        self,
        kind: Kind,
        terms: Iterable[tuple[Fact, Scalar]],
        *,
        constant: Scalar = 0,
        expect: Affine | None = None,
    ) -> Fact: ...
    def assign(self, checks: Iterable[Fact | None]) -> None: ...

def assemble(source: str, target: str) -> None: ...
def disassemble(source: str, target: str) -> None: ...
def verify(
    source: str,
    target: str,
    proof: str,
    *,
    work: int | None = None,
    live_facts: int | None = None,
    depth: int | None = None,
) -> dict[str, Any]: ...

class StepView:
    @property
    def kind(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
