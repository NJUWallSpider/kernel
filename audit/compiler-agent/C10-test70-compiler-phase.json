      "code": "t0=time.time()\nsubset_requests=collections.defaultdict(dict)\nfor ri in changed_gates:\n for ar,T in covers[ri][1]: subset_requests[ar][T]=None\nsubset_facts={}\nfor ar,requests in subset_requests.items():\n Ts=list(requests)\n facts=f.subset_bounds(packing_facts[ar],Ts)\n subset_facts[ar]=dict(zip(Ts,facts))\nprint('subset bounds established',sum(len(x) for x in subset_facts.values()),'packing premises',len(subset_facts),'seconds',round(time.time()-t0,2))\n# Add the disjoint subset bounds to obtain sum(S)<=U, then split only on y.\nfor ri,(y,M,U) in changed_gates.items():\n S=gate_by_row[ri][2]\n _,groups,singles=covers[ri]\n terms=[(subset_facts[ar][T],1) for ar,T in groups]\n terms.extend((f.upper(source.vars[j].name),1) for j in singles)\n bound=f.le(terms,expect=Expr(-U,{j:1 for j in S}))\n goal=Expr(0,{**{j:Fraction(1) for j in S},y:-Fraction(U)})\n old=f.row(source.rows[ri].name)\n result=f.cases(source.var(source.vars[y].name),kind='Le',expect=goal,\n  left=lambda b,assume,old=old,M=M,U=U,goal=goal:b.le([(old,1),(assume,M-U)],expect=goal),\n  right=lambda b,assume,bound=bound,U=U,goal=goal:b.le([(bound,1),(assume,U)],expect=goal))\n f.check('row.upper['+source.rows[ri].name+']',result)\nprint('gate strengthening certified',len(changed_gates),'seconds',round(time.time()-t0,2))\n# Rewritten definition equalities and objective comparison use the proved fixed values.\nf.substitution({source.vars[j].name:fact for j,fact in fix_facts.items()})\nobj_terms=[(f.lower(source.vars[j].name),source.objective.coefficient(j)) for j in isolated]\nobj_terms.extend((fact,-source.objective.coefficient(j)) for j,fact in fix_facts.items() if source.objective.coefficient(j))\nobj_fact=f.le(obj_terms)\nf.check('objective.non_increasing',obj_fact)\nmissing=f.missing()\nprint('forward missing',len(missing),[(g.label,g.kind,g.expression.summary()) for g in missing[:5]])\nf.complete()\nprint('forward completed')"
